# A aplicação lê o ambiente do processo. Estes valores repetem os defaults locais.
# No compose, o serviço api recebe as mesmas chaves. Em produção, a senha viria
# do Secrets Manager injetada no ambiente — a aplicação não busca o secret.

PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_USER=jungle
DB_PASSWORD=jungle
DB_NAME=jungle_rounds
DB_AUTO_MIGRATE=true
EVENT_BUS=local

# EVENT_BUS=sqs
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/jungle-rounds
